{
  "name": "games-whats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp bot dedicated to self-contained HTML mini games rendered as rich responses",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "pair": "node dist/pair.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "7.0.0-rc14",
    "dotenv": "^17.2.1",
    "pino": "^9.9.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
